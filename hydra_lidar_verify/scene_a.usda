#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Target"
    {
        color3f[] primvars:displayColor = [(0.86, 0.34, 0.22)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (2, 2, 2)
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Floor"
    {
        color3f[] primvars:displayColor = [(0.42, 0.44, 0.48)] (
            interpolation = "constant"
        )
        double3 xformOp:scale = (14, 0.1, 14)
        double3 xformOp:translate = (0, -0.05, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DistantLight "KeyLight"
    {
        float inputs:intensity = 5000
        float xformOp:rotateX = -45
        float xformOp:rotateY = 35
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
    }

    def DistantLight "FillLight"
    {
        float inputs:intensity = 1800
        float xformOp:rotateX = -25
        float xformOp:rotateY = -120
        uniform token[] xformOpOrder = ["xformOp:rotateY", "xformOp:rotateX"]
    }

    def Camera "RenderCamera"
    {
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float3 xformOp:rotateXYZ = (-12, 0, 0)
        double3 xformOp:translate = (0, 2.2, 7.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "LidarCamera"
    {
        bool lidar:isLidar = 1
        float lidar:azimuthMinDeg = -35
        float lidar:azimuthMaxDeg = 35
        float lidar:azimuthStepDeg = 2
        float lidar:verticalMinDeg = -4
        float lidar:verticalMaxDeg = -20
        float lidar:verticalStepDeg = 2
        float lidar:pointRadiusPixels = 3
        float lidar:maxDistance = 30
        float focalLength = 35
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float3 xformOp:rotateXYZ = (0, 90, 0)
        double3 xformOp:translate = (4.5, 1.3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}

def "Render"
{
    def RenderSettings "Settings"
    {
        rel camera = </World/RenderCamera>
        rel products = [</Render/Products/Beauty>, </Render/Products/Lidar>]
        uniform int2 resolution = (512, 512)
    }

    def "Products"
    {
        def RenderProduct "Beauty"
        {
            rel camera = </World/RenderCamera>
            rel orderedVars = </Render/Vars/Beauty>
            token productName = "outputs/scene_a_beauty.png"
            uniform token productType = "raster"
            uniform int2 resolution = (512, 512)
        }

        def RenderProduct "Lidar"
        {
            rel camera = </World/RenderCamera>
            rel orderedVars = </Render/Vars/Lidar>
            token productName = "outputs/scene_a_lidar.png"
            uniform token productType = "raster"
            uniform int2 resolution = (512, 512)
        }
    }

    def "Vars"
    {
        def RenderVar "Beauty"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "color"
            uniform token sourceType = "raw"
        }

        def RenderVar "Lidar"
        {
            uniform token dataType = "color4f"
            uniform string sourceName = "lidar:pointCloud"
            uniform token sourceType = "raw"
        }
    }
}
