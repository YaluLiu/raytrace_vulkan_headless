#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require


#include "raycommon.glsl"
#include "wavefront.glsl"

const float kFloatMinValue                                      = 1e-15;
const float kLidarDepthCompositeEpsilon                         = 1e-3;

float positiveRcp(float x)
{
  return 1.0 / max(x, kFloatMinValue);
}

vec3 reinhardMax(vec3 color)
{
  float maxChannel = max(max(color.x, color.y), color.z);
  return (maxChannel > 0.0) ? (color / (1.0 + maxChannel)) : vec3(0.0);
}

vec3 environmentTermRtg(vec3 f0, float noV, float alphaRoughness)
{
  vec4 x = vec4(1.0, noV, noV * noV, noV * noV * noV);
  vec4 y = vec4(1.0, alphaRoughness, alphaRoughness * alphaRoughness, alphaRoughness * alphaRoughness * alphaRoughness);

  vec2 m1x = vec2(0.99044 * x.x - 1.28514 * x.y, 1.29678 * x.x - 0.755907 * x.y);
  vec3 m2x = vec3(1.0 * x.x + 2.92338 * x.y + 59.4188 * x.w, 20.3225 * x.x - 27.0302 * x.y + 222.592 * x.w,
                  121.563 * x.x + 626.13 * x.y + 316.627 * x.w);
  vec2 m3x = vec2(0.0365463 * x.x + 3.32707 * x.y, 9.0632 * x.x - 9.04756 * x.y);
  vec3 m4x = vec3(1.0 * x.x + 3.59685 * x.z - 1.36772 * x.w, 9.04401 * x.x - 16.3174 * x.z + 9.22949 * x.w,
                  5.56589 * x.x + 19.7886 * x.z - 20.2123 * x.w);

  float bias  = dot(m1x, y.xy) * positiveRcp(dot(m2x, y.xyw));
  float scale = dot(m3x, y.xy) * positiveRcp(dot(m4x, y.xyw));
  return clamp(f0 * scale + vec3(bias), vec3(0.0), vec3(1.0));
}

// clang-format off
layout(location = 0) rayPayloadEXT hitPayload prd;

layout(set = 0, binding = eTlas) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = eOutImage, rgba32f) uniform image2D image;
layout(set = 0, binding = eObjIdImage, r32i) uniform iimage2D objectIdImage;
layout(set = 0, binding = eInsIdImage, r32i) uniform iimage2D instanceIdImage;
layout(set = 0, binding = eDiffuseAlbedoImage, rgba32f) uniform image2D diffuseAlbedoImage;
layout(set = 0, binding = eSpecularAlbedoImage, rgba32f) uniform image2D specularAlbedoImage;
layout(set = 0, binding = eNormalRoughnessImage, rgba32f) uniform image2D normalRoughnessImage;
layout(set = 0, binding = eMotionVectorImage, rg32f) uniform image2D motionVectorImage;
layout(set = 0, binding = eLinearDepthImage, r32f) uniform image2D linearDepthImage;
layout(set = 0, binding = eSpecularHitDistImage, r32f) uniform image2D specularHitDistanceImage;
layout(set = 0, binding = eDistanceToCameraImage, r32f) uniform image2D distanceToCameraImage;
layout(set = 0, binding = eLidarPointCloudImage, rgba32f) uniform image2D lidarPointCloudImage;
layout(set = 1, binding = eFrameUniforms) uniform _FrameUniforms { FrameUniforms frameUni; };
layout(push_constant) uniform _PushConstantRay { PushConstantRay pcRay; };
// clang-format on

#include "lidar_pointcloud.glsl"


void main()
{
  if(pcRay.lidarPassMode == 0)
  {
    int azCount   = lidarAxisSampleCount(pcRay.lidar.azimuthMinDeg, pcRay.lidar.azimuthMaxDeg, pcRay.lidar.azimuthStepDeg);
    int elCount   = lidarAxisSampleCount(pcRay.lidar.verticalMinDeg, pcRay.lidar.verticalMaxDeg, pcRay.lidar.verticalStepDeg);
    int totalRays = azCount * elCount;
    uint rayIdx   = gl_LaunchIDEXT.x + gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x;

    if(rayIdx < uint(max(totalRays, 0)))
    {
      vec3 worldHit;
      if(traceLidarHit(rayIdx, worldHit))
      {
        ivec2 screenPixel;
        if(projectWorldToMainPixel(worldHit, screenPixel))
        {
          float lidarViewZ = computeMainViewZ(worldHit);
          splatPoint(screenPixel, pcRay.lidar.pointRadiusPixels, vec3(1.0, 0.0, 0.0), lidarViewZ);
        }
      }
    }
    return;
  }

  ivec2 pixel       = ivec2(gl_LaunchIDEXT.xy);
  vec2  pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
  vec2  cameraJitter = vec2(pcRay.jitterX, pcRay.jitterY);
  int   spp         = max(pcRay.samplesPerFrame, 1);

  vec3 sampleColor             = vec3(0.0);
  int  sampleObjId             = -1;
  int  sampleInsId             = -1;
  vec4 sampleWorldPosRoughness = vec4(0.0);
  vec4 sampleNormalHitDist     = vec4(0.0);
  vec4 sampleDiffuseValid      = vec4(0.0);
  vec4 sampleSpecular          = vec4(0.04, 0.04, 0.04, 0.0);

  for(int sampleIdx = 0; sampleIdx < spp; ++sampleIdx)
  {
    uint seed   = initRng(gl_LaunchIDEXT.xy, pcRay.frameIndex, uint(sampleIdx));
    vec2 inUV   = (pixelCenter + cameraJitter) / vec2(gl_LaunchSizeEXT.xy);
    vec2 d      = inUV * 2.0 - 1.0;

    vec4 origin    = frameUni.camera.viewInverse * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target    = frameUni.camera.projInverse * vec4(d.x, d.y, 1.0, 1.0);
    vec4 direction = frameUni.camera.viewInverse * vec4(normalize(target.xyz), 0.0);

    prd.radiance                  = vec3(0.0);
    prd.objId                     = -1;
    prd.instanceId                = -1;
    prd.throughput                = vec3(1.0);
    prd.seed                      = seed;
    prd.depth                     = 0;
    prd.done                      = 0;
    prd.firstHitWorldPosRoughness = vec4(0.0);
    prd.firstHitNormalSpecHitDist = vec4(0.0);
    prd.firstHitDiffuseValid      = vec4(0.0);
    prd.firstHitSpecularPad       = vec4(0.04, 0.04, 0.04, 0.0);

    traceRayEXT(topLevelAS,  // acceleration structure
                gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin.xyz, 0.001, direction.xyz, 10000.0, 0);

    sampleColor += prd.radiance;
    if(sampleIdx == 0)
    {
      sampleObjId             = prd.objId;
      sampleInsId             = prd.instanceId;
      sampleWorldPosRoughness = prd.firstHitWorldPosRoughness;
      sampleNormalHitDist     = prd.firstHitNormalSpecHitDist;
      sampleDiffuseValid      = prd.firstHitDiffuseValid;
      sampleSpecular          = prd.firstHitSpecularPad;
    }
  }

  sampleColor /= float(spp);

  vec3 outColor = sampleColor;

  imageStore(objectIdImage, pixel, ivec4(sampleObjId, 0, 0, 0));
  imageStore(instanceIdImage, pixel, ivec4(sampleInsId, 0, 0, 0));

  vec3  diffuseAlbedo      = clamp(sampleDiffuseValid.xyz, vec3(0.0), vec3(1.0));
  vec3  specularAlbedo     = vec3(0.0);
  float metallic           = 0.0;
  vec3  packedNormal       = vec3(0.0);
  float packedRoughness    = 0.0;
  float linearDepth        = kDlssInfDistance;
  float distanceToCamera   = 0.0;
  vec2  motionVectorPixels = vec2(0.0);
  float specHitDistance    = max(sampleNormalHitDist.w, 0.0);
  bool  hasPrimaryHit      = sampleDiffuseValid.w > 0.5;
  float primaryViewZ       = kDlssInfDistance;

  if(hasPrimaryHit)
  {
    vec3 cameraPos   = (frameUni.camera.viewInverse * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
    vec4 worldPos    = vec4(sampleWorldPosRoughness.xyz, 1.0);
    distanceToCamera = length(cameraPos - worldPos.xyz);
    vec4  viewPos    = frameUni.camera.view * worldPos;
    float viewZ      = max(-viewPos.z, 0.0);
    primaryViewZ     = viewZ;
    linearDepth      = viewZ;
    packedNormal     = normalize(sampleNormalHitDist.xyz);

    float roughnessSquared = clamp(sampleWorldPosRoughness.w, 0.0, 1.0);
    float alphaRoughness   = sqrt(roughnessSquared);
    packedRoughness        = alphaRoughness;

    vec3  toEye = normalize(cameraPos - worldPos.xyz);
    float noV   = max(dot(packedNormal, toEye), 0.0);
    vec3  f0    = clamp(sampleSpecular.xyz, vec3(0.0), vec3(0.98));
    if(sampleSpecular.w > 0.5)
    {
      specularAlbedo = environmentTermRtg(f0, noV, roughnessSquared);
      // OBJ path does not provide metallic explicitly; approximate it from specular F0.
      float f0Max = max(f0.x, max(f0.y, f0.z));
      metallic    = clamp((f0Max - 0.04) / 0.96, 0.0, 1.0);
    }
    else
    {
      specularAlbedo = vec3(0.0);
      metallic       = 0.0;
    }

    vec4  prevClip     = frameUni.camera.prevViewProj * worldPos;
    float invW         = abs(prevClip.w) > 1e-6 ? (1.0 / prevClip.w) : 0.0;
    vec2  prevNdc      = prevClip.xy * invW;
    vec2  prevPixel    = (prevNdc * 0.5 + 0.5) * vec2(gl_LaunchSizeEXT.xy);
    vec2  currPixel    = pixelCenter + cameraJitter;
    motionVectorPixels = prevPixel - currPixel;
  }
  else
  {
    vec3 skyGuide      = reinhardMax(max(outColor, vec3(0.0)));
    diffuseAlbedo      = skyGuide;
    specularAlbedo     = vec3(0.0);
    packedNormal       = vec3(0.0);
    packedRoughness    = 0.0;
    linearDepth        = kDlssInfDistance;
    distanceToCamera   = 0.0;
    motionVectorPixels = vec2(0.0);
    specHitDistance    = 0.0;
    metallic           = 0.0;
  }

  imageStore(diffuseAlbedoImage, pixel, vec4(diffuseAlbedo, metallic));
  imageStore(specularAlbedoImage, pixel, vec4(specularAlbedo, 0.0));
  imageStore(normalRoughnessImage, pixel, vec4(packedNormal, packedRoughness));
  imageStore(motionVectorImage, pixel, vec4(motionVectorPixels, 0.0, 0.0));
  imageStore(linearDepthImage, pixel, vec4(linearDepth, 0.0, 0.0, 0.0));
  imageStore(specularHitDistanceImage, pixel, vec4(specHitDistance, 0.0, 0.0, 0.0));
  imageStore(distanceToCameraImage, pixel, vec4(distanceToCamera, 0.0, 0.0, 0.0));

  if(pcRay.lidarPassMode == 1)
  {
    vec4  lidarPoint    = imageLoad(lidarPointCloudImage, pixel);
    float lidarViewZ    = lidarPoint.a;
    bool  hasLidarPoint = lidarViewZ > 0.0;
    bool  lidarVisible  = (!hasPrimaryHit) || (lidarViewZ <= primaryViewZ + kLidarDepthCompositeEpsilon);
    if(hasLidarPoint && lidarVisible)
    {
      outColor = lidarPoint.rgb;
    }
  }

  imageStore(image, pixel, vec4(outColor, 1.0));
}
