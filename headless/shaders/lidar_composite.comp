#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "host_device.h"

const float kLidarDepthCompositeEpsilon = 1e-3;
const float kLidarDepthKeyMaxF          = 16777214.0;
const uint  kLidarEmptyDepthKey         = 0xffffffffu;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = eCompositeDenoisedImage, rgba32f) uniform image2D denoisedImage;
layout(set = 0, binding = eCompositeLidarPointCloudImage, rgba32f) uniform image2D lidarPointCloudImage;
layout(set = 0, binding = eCompositeDepthImage, r32f) uniform image2D depthImage;
layout(set = 0, binding = eCompositeLidarDepthKeyImage, r32ui) uniform uimage2D lidarPointCloudDepthKeyImage;

void main()
{
  ivec2 pixel       = ivec2(gl_GlobalInvocationID.xy);
  ivec2 colorExtent = imageSize(denoisedImage);
  if(any(greaterThanEqual(pixel, colorExtent)))
  {
    return;
  }

  ivec2 lidarExtent = imageSize(lidarPointCloudDepthKeyImage);
  ivec2 lidarPixel  = ivec2(clamp((vec2(pixel) + vec2(0.5)) * vec2(lidarExtent) / vec2(colorExtent), vec2(0.0),
                                  vec2(lidarExtent - ivec2(1))));

  uint lidarDepthKey = imageLoad(lidarPointCloudDepthKeyImage, lidarPixel).r;
  if(lidarDepthKey == kLidarEmptyDepthKey)
  {
    return;
  }

  float lidarDepth   = float(lidarDepthKey) / kLidarDepthKeyMaxF;
  float sceneDepth   = imageLoad(depthImage, lidarPixel).r;
  bool  lidarVisible = lidarDepth <= sceneDepth + kLidarDepthCompositeEpsilon;
  imageStore(lidarPointCloudImage, lidarPixel, vec4(1.0, 0.0, 0.0, lidarDepth));
  if(!lidarVisible)
  {
    return;
  }

  vec4 color = imageLoad(denoisedImage, pixel);
  imageStore(denoisedImage, pixel, vec4(1.0, 0.0, 0.0, color.a));
}
